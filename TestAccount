public class TestAccount{
    public static void main(String[] args) {
        System.out.println("==================================================");
        System.out.println("  GLOBAL DIGITAL BANK - ACCOUNT TEST");
        System.out.println("==================================================");
        System.out.println(">>> 1. Creating Account");
        Account a1 = new Account(1001,"John Doe",25,1000,"Savings");
        System.out.println("Account created!");

        System.out.println(
                "Account #" + a1.getAccountNumber()
                        + " | " + a1.getName()
                        + " (" + a1.getAge() + " yrs)"
                        + " | " + a1.getAccounttype()
                        + " | ₹" + a1.getBalance()
                        + " | " + a1.getStatus()
        );
        System.out.println(">>> 2. Deposit Money");
        double depositmoney = 500.0;
        if (a1.deposit(depositmoney)) {
            System.out.println(
                    "Depositing ₹" + depositmoney + ": SUCCESS"
            );
        } else {
            System.out.println(
                    "Depositing ₹" + depositmoney + ": FAILED"
            );
        }
        System.out.println(
                "New balance: ₹" + a1.getBalance()
        );
        double invalidDeposit = -100.0;
        if (a1.deposit(invalidDeposit)) {
            System.out.println(
                    "Depositing ₹" + invalidDeposit + ": SUCCESS"
            );
        } else {
            System.out.println(
                    "Depositing ₹" + invalidDeposit
                            + ": FAILED (Invalid amount)"
            );
        }
        System.out.println(">>> 3. Withdraw Money");
        double withdrawAmount = 200.0;
        if (a1.withdraw(withdrawAmount)) {
            System.out.println(
                    "Withdrawing ₹" + withdrawAmount + ": SUCCESS"
            );
        } else {
            System.out.println(
                    "Withdrawing ₹" + withdrawAmount + ": FAILED"
            );
        }

        System.out.println(
                "New balance: ₹" + a1.getBalance()
        );
        double largeWithdrawal = 2000.0;
        if (a1.withdraw(largeWithdrawal)) {
            System.out.println(
                    "Withdrawing ₹" + largeWithdrawal + ": SUCCESS"
            );
        } else {
            System.out.println(
                    "Withdrawing ₹" + largeWithdrawal
                            + ": FAILED (Insufficient balance)"
            );
        }
        System.out.println(
                "Current balance: ₹" + a1.getBalance()
        );
        System.out.println(">>> 4. Creating Another Account");

        Account account2 = new Account(
                1002,
                "Jane Smith",
                30,
                2000.0,
                "Current"
        );

        System.out.println(
                "Account #" + account2.getAccountNumber()
                        + " | " + account2.getName()
                        + " (" + account2.getAge() + " yrs)"
                        + " | " + account2.getAccounttype()
                        + " | ₹" + account2.getBalance()
                        + " | " + account2.getStatus()
        );
        System.out.println(">>> 5. All Accounts");
        System.out.println(
                "Account #" + a1.getAccountNumber()
                        + " | " + a1.getName()
                        + " (" + a1.getAge() + " yrs)"
                        + " | " + a1.getAccounttype()
                        + " | ₹" + a1.getBalance()
                        + " | " + a1.getStatus()
        );

        System.out.println(
                "Account #" + account2.getAccountNumber()
                        + " | " + account2.getName()
                        + " (" + account2.getAge() + " yrs)"
                        + " | " + account2.getAccounttype()
                        + " | ₹" + account2.getBalance()
                        + " | " + account2.getStatus()
        );

        System.out.println("==================================================");
        System.out.println("  TEST COMPLETED!");
        System.out.println("==================================================");
    }
}
